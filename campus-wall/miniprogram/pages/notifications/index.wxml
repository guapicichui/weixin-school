<view class="container">
 <view class="hero"><text class="eyebrow">STAY CONNECTED</text><text class="title">校园里的回应</text><text class="subtitle">评论、跑腿进展和申请结果，都在这里。</text></view>
 <view wx:if="{{error}}" class="error-box">{{error}}<view class="link" bindtap="refresh">点击重试</view></view>
 <view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view class="row-start"><view wx:if="{{!item.read}}" class="badge"></view><text class="author">{{item.title}}</text></view><view class="row" style="margin-top:20rpx"><text class="meta">{{item.time}}</text><text class="link">查看 ›</text></view></view>
 <view wx:if="{{!items.length && !loading && !error}}" class="empty"><text class="empty-title">暂时没有新消息</text>去微墙参与讨论，收获同学们的回应吧</view>
 <view wx:if="{{loading}}" class="empty">加载中…</view>
</view>
