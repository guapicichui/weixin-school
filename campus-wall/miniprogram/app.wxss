page{background:#f6f8f5;color:#213b30;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}
view,text,input,textarea,button{box-sizing:border-box}
.container{padding:30rpx 28rpx 64rpx}
.hero{padding:18rpx 4rpx 30rpx}
.eyebrow{font-size:21rpx;letter-spacing:4rpx;color:#74907f;font-weight:600}
.title{display:block;font-size:50rpx;font-weight:700;line-height:1.4;margin:12rpx 0}
.subtitle{display:block;color:#7c8e82;font-size:25rpx;line-height:1.8}
.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.row-start{display:flex;align-items:center;gap:16rpx}
.card{background:#fff;border:1rpx solid #e9eee8;border-radius:24rpx;padding:28rpx;margin-bottom:22rpx}
.banner{background:#e6f1e7;border-radius:24rpx;padding:28rpx;margin-bottom:28rpx}
.banner-title{font-size:30rpx;font-weight:600;margin-bottom:12rpx}
.avatar{width:70rpx;height:70rpx;border-radius:24rpx;display:flex;align-items:center;justify-content:center;background:#edf2e6;color:#4c7150;font-size:28rpx;font-weight:600;flex-shrink:0}
.author{font-size:25rpx;font-weight:500}
.meta{font-size:22rpx;color:#91a095;margin-top:6rpx}
.tag{display:inline-block;border-radius:10rpx;background:#edf4ed;color:#638568;font-size:21rpx;padding:7rpx 13rpx}
.card-title{display:block;font-size:33rpx;font-weight:600;margin:24rpx 0 14rpx;line-height:1.5}
.body{display:block;font-size:27rpx;color:#64776a;line-height:1.9;white-space:pre-wrap;word-break:break-all}
.clamp{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden}
.footer{display:flex;align-items:center;justify-content:space-between;margin-top:26rpx;padding-top:20rpx;border-top:1rpx solid #f1f4ef;color:#8c9d90;font-size:23rpx}
.chips{display:flex;gap:14rpx;padding:0 0 26rpx;white-space:nowrap}
.chip{display:inline-block;margin-right:14rpx;padding:16rpx 25rpx;border-radius:30rpx;background:#eaf0e9;color:#7d8d7d;font-size:25rpx}
.chip.active{background:#236d50;color:#fff}
button{font-size:27rpx;border-radius:16rpx;line-height:1.6;padding:20rpx 28rpx;background:#edf2eb;color:#456b50;margin:0}
button::after{border:0}
button.primary{background:#1e6b4b;color:#fff}
button.secondary{background:#fff;border:1rpx solid #dce6da;color:#37644a}
button.danger{background:#fff0eb;color:#b3624c}
button.small{font-size:23rpx;padding:12rpx 22rpx;border-radius:12rpx}
button[disabled]{opacity:.5}
.fab{position:fixed;right:30rpx;bottom:38rpx;bottom:calc(38rpx + env(safe-area-inset-bottom));box-shadow:0 8rpx 28rpx #1c5a4c30;z-index:5}
.empty{padding:70rpx 24rpx;text-align:center;color:#8b9b8e;line-height:2}
.empty-title{display:block;color:#5e7963;font-size:30rpx;margin-bottom:12rpx}
.link{color:#2d7757;font-size:25rpx;padding:12rpx 0}
.field{margin-bottom:28rpx}
.label{display:block;font-size:26rpx;font-weight:500;margin-bottom:16rpx}
input,textarea,.picker{background:#f5f7f2;border-radius:16rpx;padding:24rpx;width:100%;font-size:28rpx;color:#284331}
input{height:90rpx}
textarea{min-height:240rpx;line-height:1.8}
.hint{display:block;font-size:23rpx;line-height:1.8;color:#8e9c90;margin:14rpx 0}
.section-title{display:block;font-size:31rpx;font-weight:600;margin:28rpx 0 20rpx}
.actions{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:24rpx}
.actions button{flex:1}
.fee{color:#b9784b;font-size:38rpx;font-weight:600}
.status{font-size:23rpx;color:#6d895e;background:#f0f4e8;border-radius:10rpx;padding:8rpx 15rpx}
.route{margin:24rpx 0;color:#526c59;line-height:1.9}
.divider{height:1rpx;background:#edf1e9;margin:24rpx 0}
.menu-item{padding:28rpx 4rpx;border-bottom:1rpx solid #eef2eb;display:flex;justify-content:space-between;align-items:center}
.menu-item:last-child{border-bottom:0}
.error-box{background:#fff0e9;color:#a36b51;border-radius:18rpx;padding:24rpx;line-height:1.8;margin-bottom:22rpx}
.note{background:#fff5e7;color:#9b7c4c;padding:22rpx;border-radius:16rpx;font-size:23rpx;line-height:1.8;margin-bottom:24rpx}
.badge{width:12rpx;height:12rpx;background:#d18b61;border-radius:50%;margin-right:10rpx}
